<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="@drawable/panel_background" android:layout_marginBottom="12dp">
  <TextView android:id="@+id/tratamiento_descripcion" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.DetalMick.Body" android:textStyle="bold" android:textSize="16sp" android:layout_marginBottom="4dp" />
  <TextView android:id="@+id/tratamiento_detalles" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.DetalMick.Body" android:textSize="14sp" android:layout_marginBottom="8dp" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal">
      <TextView android:id="@+id/tratamiento_fecha" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Text.DetalMick.Body" android:textSize="13sp" />
      <TextView android:id="@+id/tratamiento_costo" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Text.DetalMick.Body" android:textSize="13sp" android:textColor="@color/primary" android:textStyle="bold" android:layout_marginStart="16dp" />
    </LinearLayout>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginTop="8dp">
    <TextView android:id="@+id/tratamiento_estado" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" style="@style/Text.DetalMick.Body" android:textSize="13sp" android:padding="4dp" android:background="@drawable/panel_background" />
    <Button android:id="@+id/btn_detalle_tratamiento" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Ver Detalle" android:textSize="12sp" android:paddingHorizontal="8dp" android:paddingVertical="4dp" android:gravity="end" />
  </LinearLayout>
</LinearLayout>
