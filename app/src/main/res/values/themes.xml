<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="Theme.DetalMick" parent="Theme.Material3.Light.NoActionBar">
    <item name="colorPrimary">@color/primary</item>
    <item name="colorOnPrimary">@color/on_primary</item>
    <item name="colorSurface">@color/surface</item>
    <item name="colorOnSurface">@color/ink</item>
    <item name="android:colorBackground">@color/background</item>
    <item name="android:windowLightStatusBar">true</item>
    <item name="android:fontFamily">sans</item>
    <item name="materialButtonStyle">@style/Widget.DetalMick.Button</item>
    <item name="textInputStyle">@style/Widget.DetalMick.Input</item>
  </style>
  <style name="Widget.DetalMick.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
    <item name="hintAnimationEnabled">false</item>
  </style>
  <style name="Widget.DetalMick.Button" parent="Widget.Material3.Button">
    <item name="android:minHeight">56dp</item>
    <item name="android:textSize">16sp</item>
    <item name="android:textAllCaps">false</item>
    <item name="cornerRadius">16dp</item>
  </style>
  <style name="Text.DetalMick.Title" parent="TextAppearance.Material3.HeadlineMedium">
    <item name="android:textSize">28sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textColor">@color/ink</item>
  </style>
  <style name="Text.DetalMick.Body" parent="TextAppearance.Material3.BodyLarge">
    <item name="android:textSize">16sp</item>
    <item name="android:textColor">@color/muted</item>
    <item name="android:lineSpacingExtra">4dp</item>
  </style>
</resources>
